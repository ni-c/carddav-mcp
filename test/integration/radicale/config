# Radicale for the integration suite. Not a template for anything real: it has
# plaintext passwords and no TLS, which is fine for a throwaway container bound
# to loopback and nothing else.
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /etc/radicale/users
htpasswd_encryption = plain

[storage]
filesystem_folder = /data/collections
